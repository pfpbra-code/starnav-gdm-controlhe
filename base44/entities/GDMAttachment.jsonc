{
  "name": "GDMAttachment",
  "type": "object",
  "properties": {
    "gdm_id": {
      "type": "string",
      "description": "ID da GDM vinculada"
    },
    "gdm_item_id": {
      "type": "string",
      "description": "ID do item da GDM ao qual o arquivo pertence"
    },
    "vessel_id": {
      "type": "string",
      "description": "ID da embarca\u00e7\u00e3o (denormalizado para escopo de acesso)"
    },
    "file_name": {
      "type": "string",
      "description": "Nome original do arquivo"
    },
    "file_uri": {
      "type": "string",
      "description": "Caminho do arquivo no armazenamento privado (acesso via URL assinada)"
    },
    "file_type": {
      "type": "string",
      "description": "Tipo MIME do arquivo (image/jpeg, image/png, image/webp, application/pdf)"
    },
    "file_size": {
      "type": "number",
      "description": "Tamanho do arquivo em bytes"
    },
    "attachment_type": {
      "type": "string",
      "enum": [
        "descarte_foto",
        "descarte_pdf",
        "documento_descarte"
      ],
      "description": "Tipo de comprova\u00e7\u00e3o: foto do descarte, PDF do descarte ou outro documento comprobat\u00f3rio"
    },
    "uploaded_by": {
      "type": "string",
      "description": "Email de quem anexou o arquivo"
    },
    "uploaded_at": {
      "type": "string",
      "format": "date-time",
      "description": "Data/hora do envio do arquivo"
    },
    "description": {
      "type": "string",
      "description": "Observa\u00e7\u00e3o relacionada ao documento"
    }
  },
  "required": [
    "gdm_id",
    "gdm_item_id",
    "file_name",
    "file_uri",
    "attachment_type"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "coordinator"
          }
        },
        {
          "user_condition": {
            "role": "services"
          }
        },
        {
          "user_condition": {
            "role": "maintenance"
          }
        },
        {
          "user_condition": {
            "role": "almoxarifado"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.vessel_id": "{{user.data.vessel_id}}"
        },
        {
          "data.vessel_id": {
            "$in": "{{user.data.assigned_vessels}}"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "coordinator"
          }
        },
        {
          "user_condition": {
            "role": "services"
          }
        },
        {
          "user_condition": {
            "role": "maintenance"
          }
        },
        {
          "user_condition": {
            "role": "almoxarifado"
          }
        },
        {
          "user_condition": {
            "role": "planejamento"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
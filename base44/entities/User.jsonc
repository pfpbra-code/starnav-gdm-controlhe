{
  "name": "User",
  "type": "object",
  "properties": {
    "role": {
      "type": "string",
      "enum": [
        "admin",
        "user",
        "vessel_user"
      ],
      "default": "user",
      "description": "Perfil: Administrador ou Usu\u00e1rio (o login pr\u00f3prio das Embarca\u00e7\u00f5es \u00e9 mantido \u00e0 parte)"
    },
    "sectors": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "maintenance",
          "operations",
          "almoxarifado",
          "planejamento",
          "services"
        ]
      },
      "description": "Setores vinculados ao usu\u00e1rio em Configura\u00e7\u00f5es > Respons\u00e1veis por Setor (fonte \u00fanica das permiss\u00f5es b\u00e1sicas)"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "inactive",
        "suspended"
      ],
      "default": "active"
    },
    "assigned_vessels": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "vessel_id": {
      "type": "string"
    },
    "permissions": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Autoriza\u00e7\u00f5es individuais concedidas pelo ADM, al\u00e9m das permiss\u00f5es b\u00e1sicas dos setores"
    },
    "photo_url": {
      "type": "string",
      "description": "URL da foto de perfil (edit\u00e1vel pelo pr\u00f3prio usu\u00e1rio)"
    },
    "cover_url": {
      "type": "string",
      "description": "URL da imagem de capa do perfil (edit\u00e1vel pelo pr\u00f3prio usu\u00e1rio)"
    },
    "phone": {
      "type": "string",
      "description": "Telefone de contato (edit\u00e1vel pelo pr\u00f3prio usu\u00e1rio)"
    },
    "job_title": {
      "type": "string",
      "description": "Cargo/fun\u00e7\u00e3o do usu\u00e1rio (edit\u00e1vel pelo pr\u00f3prio usu\u00e1rio)"
    },
    "login_history": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "timestamp": {
            "type": "string"
          },
          "ip_address": {
            "type": "string"
          },
          "user_agent": {
            "type": "string"
          },
          "success": {
            "type": "boolean"
          }
        }
      }
    },
    "last_login": {
      "type": "string",
      "format": "date-time"
    },
    "password_changed_at": {
      "type": "string",
      "format": "date-time"
    },
    "password_expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "require_password_change": {
      "type": "boolean",
      "default": false
    },
    "failed_login_attempts": {
      "type": "number",
      "default": 0
    },
    "account_locked_until": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": []
}
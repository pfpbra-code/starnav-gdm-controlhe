{
  "name": "User",
  "type": "object",
  "properties": {
    "role": {
      "type": "string",
      "enum": [
        "admin",
        "user",
        "vessel_user"
      ],
      "default": "user",
      "description": "Perfil: Administrador ou Usu\u00e1rio (o login pr\u00f3prio das Embarca\u00e7\u00f5es \u00e9 mantido \u00e0 parte). Campo protegido: alterado apenas por administradores, via fun\u00e7\u00e3o de backend manageUserAccount",
      "rls": {
        "update": {
          "user_condition": {
            "collaborator_role": "editor"
          }
        }
      }
    },
    "sectors": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "maintenance",
          "operations",
          "almoxarifado",
          "planejamento",
          "services",
          "coordinator"
        ]
      },
      "description": "Setores vinculados ao usu\u00e1rio em Configura\u00e7\u00f5es > Respons\u00e1veis por Setor (fonte \u00fanica das permiss\u00f5es b\u00e1sicas)"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "inactive",
        "suspended",
        "deleted"
      ],
      "default": "active",
      "description": "Situa\u00e7\u00e3o operacional da conta. Campo protegido: alterado apenas por administradores, via fun\u00e7\u00e3o de backend manageUserAccount",
      "rls": {
        "update": {
          "user_condition": {
            "collaborator_role": "editor"
          }
        }
      }
    },
    "account_status": {
      "type": "string",
      "enum": [
        "pending_approval",
        "approved",
        "rejected",
        "disabled",
        "deleted"
      ],
      "default": "pending_approval",
      "description": "Estado do cadastro: pendente de aprova\u00e7\u00e3o, aprovado, recusado, bloqueado ou exclu\u00eddo. Todo novo cadastro fica pendente at\u00e9 a aprova\u00e7\u00e3o do administrador; registros legados sem o campo s\u00e3o tratados como aprovados. Campo protegido: alterado apenas por administradores, via fun\u00e7\u00e3o de backend manageUserAccount",
      "rls": {
        "update": {
          "user_condition": {
            "collaborator_role": "editor"
          }
        }
      }
    },
    "assigned_vessels": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Embarca\u00e7\u00f5es \u00e0s quais o usu\u00e1rio tem acesso. Campo protegido: atribu\u00eddo apenas por administradores, via fun\u00e7\u00e3o de backend updateUserVesselAccess",
      "rls": {
        "update": {
          "user_condition": {
            "collaborator_role": "editor"
          }
        }
      }
    },
    "vessel_id": {
      "type": "string",
      "description": "Embarca\u00e7\u00e3o vinculada ao usu\u00e1rio de perfil Embarca\u00e7\u00e3o. Campo protegido: atribu\u00eddo apenas por administradores, via fun\u00e7\u00e3o de backend updateUserVesselAccess",
      "rls": {
        "update": {
          "user_condition": {
            "collaborator_role": "editor"
          }
        }
      }
    },
    "permissions": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Autoriza\u00e7\u00f5es individuais concedidas pelo ADM, al\u00e9m das permiss\u00f5es b\u00e1sicas dos setores"
    },
    "approved_by": {
      "type": "string",
      "description": "Email do administrador que aprovou o cadastro. Campo protegido (auditoria)",
      "rls": {
        "update": {
          "user_condition": {
            "collaborator_role": "editor"
          }
        }
      }
    },
    "approved_at": {
      "type": "string",
      "format": "date-time",
      "description": "Data/hora da aprova\u00e7\u00e3o do cadastro. Campo protegido (auditoria)",
      "rls": {
        "update": {
          "user_condition": {
            "collaborator_role": "editor"
          }
        }
      }
    },
    "rejected_by": {
      "type": "string",
      "description": "Email do administrador que recusou o cadastro. Campo protegido (auditoria)",
      "rls": {
        "update": {
          "user_condition": {
            "collaborator_role": "editor"
          }
        }
      }
    },
    "rejected_at": {
      "type": "string",
      "format": "date-time",
      "description": "Data/hora da recusa do cadastro. Campo protegido (auditoria)",
      "rls": {
        "update": {
          "user_condition": {
            "collaborator_role": "editor"
          }
        }
      }
    },
    "rejection_reason": {
      "type": "string",
      "description": "Justificativa da recusa informada pelo administrador. Campo protegido (auditoria)",
      "rls": {
        "update": {
          "user_condition": {
            "collaborator_role": "editor"
          }
        }
      }
    },
    "deleted_by": {
      "type": "string",
      "description": "Email do administrador que excluiu definitivamente a conta. Campo protegido (auditoria)",
      "rls": {
        "update": {
          "user_condition": {
            "collaborator_role": "editor"
          }
        }
      }
    },
    "deleted_at": {
      "type": "string",
      "format": "date-time",
      "description": "Data/hora da exclus\u00e3o definitiva da conta. Campo protegido (auditoria)",
      "rls": {
        "update": {
          "user_condition": {
            "collaborator_role": "editor"
          }
        }
      }
    },
    "deletion_reason": {
      "type": "string",
      "description": "Motivo da exclus\u00e3o definitiva informado pelo administrador. Campo protegido (auditoria)",
      "rls": {
        "update": {
          "user_condition": {
            "collaborator_role": "editor"
          }
        }
      }
    },
    "photo_url": {
      "type": "string",
      "description": "URL da foto de perfil (edit\u00e1vel pelo pr\u00f3prio usu\u00e1rio)"
    },
    "cover_url": {
      "type": "string",
      "description": "URL da imagem de capa do perfil (edit\u00e1vel pelo pr\u00f3prio usu\u00e1rio)"
    },
    "phone": {
      "type": "string",
      "description": "Telefone de contato (edit\u00e1vel pelo pr\u00f3prio usu\u00e1rio)"
    },
    "job_title": {
      "type": "string",
      "description": "Cargo/fun\u00e7\u00e3o do usu\u00e1rio (edit\u00e1vel pelo pr\u00f3prio usu\u00e1rio)"
    },
    "login_history": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "timestamp": {
            "type": "string"
          },
          "ip_address": {
            "type": "string"
          },
          "user_agent": {
            "type": "string"
          },
          "success": {
            "type": "boolean"
          }
        }
      }
    },
    "last_login": {
      "type": "string",
      "format": "date-time"
    },
    "password_changed_at": {
      "type": "string",
      "format": "date-time"
    },
    "password_expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "require_password_change": {
      "type": "boolean",
      "default": false
    },
    "failed_login_attempts": {
      "type": "number",
      "default": 0
    },
    "account_locked_until": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": []
}
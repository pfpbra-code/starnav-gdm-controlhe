{
  "name": "User",
  "type": "object",
  "properties": {
    "role": {
      "type": "string",
      "enum": [
        "admin",
        "coordinator",
        "services",
        "maintenance",
        "operations",
        "almoxarifado",
        "planejamento",
        "vessel_user",
        "user"
      ],
      "default": "user"
    },
    "department": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "inactive",
        "suspended"
      ],
      "default": "active"
    },
    "assigned_vessels": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "vessel_id": {
      "type": "string"
    },
    "permissions": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Permiss\u00f5es espec\u00edficas al\u00e9m do role"
    },
    "photo_url": {
      "type": "string",
      "description": "URL da foto de perfil (edit\u00e1vel pelo pr\u00f3prio usu\u00e1rio)"
    },
    "phone": {
      "type": "string",
      "description": "Telefone de contato (edit\u00e1vel pelo pr\u00f3prio usu\u00e1rio)"
    },
    "job_title": {
      "type": "string",
      "description": "Cargo/fun\u00e7\u00e3o do usu\u00e1rio (edit\u00e1vel pelo pr\u00f3prio usu\u00e1rio)"
    },
    "login_history": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "timestamp": {
            "type": "string"
          },
          "ip_address": {
            "type": "string"
          },
          "user_agent": {
            "type": "string"
          },
          "success": {
            "type": "boolean"
          }
        }
      }
    },
    "last_login": {
      "type": "string",
      "format": "date-time"
    },
    "password_changed_at": {
      "type": "string",
      "format": "date-time"
    },
    "password_expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "require_password_change": {
      "type": "boolean",
      "default": false
    },
    "failed_login_attempts": {
      "type": "number",
      "default": 0
    },
    "account_locked_until": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": []
}
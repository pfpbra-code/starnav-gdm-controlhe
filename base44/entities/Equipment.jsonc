{
  "name": "Equipment",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Nome do equipamento"
    },
    "code": {
      "type": "string",
      "description": "C\u00f3digo do equipamento"
    },
    "category": {
      "type": "string",
      "enum": [
        "navigation",
        "communication",
        "safety",
        "deck",
        "engine",
        "electrical",
        "hydraulic",
        "other"
      ],
      "description": "Categoria do equipamento"
    },
    "description": {
      "type": "string",
      "description": "Descri\u00e7\u00e3o do equipamento"
    },
    "location": {
      "type": "string",
      "description": "Localiza\u00e7\u00e3o f\u00edsica do equipamento"
    },
    "manufacturer": {
      "type": "string",
      "description": "Fabricante do equipamento"
    },
    "model": {
      "type": "string",
      "description": "Modelo do equipamento"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "inactive"
      ],
      "default": "active"
    }
  },
  "required": [
    "name",
    "code"
  ]
}
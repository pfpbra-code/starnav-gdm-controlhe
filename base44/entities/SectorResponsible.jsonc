{
  "name": "SectorResponsible",
  "type": "object",
  "properties": {
    "sector": {
      "type": "string",
      "enum": [
        "maintenance",
        "operations",
        "services",
        "almoxarifado",
        "planejamento",
        "coordinator"
      ],
      "description": "Setor do sistema"
    },
    "responsible_email": {
      "type": "string",
      "description": "E-mail do usu\u00e1rio respons\u00e1vel pelo setor"
    },
    "responsible_name": {
      "type": "string",
      "description": "Nome do usu\u00e1rio respons\u00e1vel pelo setor"
    },
    "notes": {
      "type": "string",
      "description": "Observa\u00e7\u00f5es sobre a responsabilidade do setor"
    }
  },
  "required": [
    "sector"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "coordinator"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
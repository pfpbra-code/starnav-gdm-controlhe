{
  "name": "Supplier",
  "type": "object",
  "properties": {
    "company_name": {
      "type": "string",
      "description": "Raz\u00e3o social"
    },
    "trading_name": {
      "type": "string",
      "description": "Nome fantasia"
    },
    "cnpj": {
      "type": "string",
      "description": "CNPJ"
    },
    "email": {
      "type": "string",
      "description": "Email principal"
    },
    "phone": {
      "type": "string"
    },
    "contact_name": {
      "type": "string",
      "description": "Nome do contato principal"
    },
    "address": {
      "type": "string",
      "description": "Endere\u00e7o completo (logradouro, cidade, estado, CEP)"
    },
    "categories": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Categorias de servi\u00e7o (Reparo, Manuten\u00e7\u00e3o, Certifica\u00e7\u00e3o, Calibra\u00e7\u00e3o etc.)"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "inactive"
      ],
      "default": "active"
    }
  },
  "required": [
    "company_name",
    "cnpj"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": null,
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
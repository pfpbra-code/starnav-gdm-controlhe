{
  "name": "Supplier",
  "type": "object",
  "properties": {
    "company_name": {
      "type": "string",
      "description": "Raz\u00e3o social"
    },
    "trading_name": {
      "type": "string",
      "description": "Nome fantasia"
    },
    "cnpj": {
      "type": "string",
      "description": "CNPJ"
    },
    "email": {
      "type": "string",
      "description": "Email principal"
    },
    "phone": {
      "type": "string"
    },
    "contact_name": {
      "type": "string",
      "description": "Nome do contato principal"
    },
    "address": {
      "type": "string",
      "description": "Endere\u00e7o completo (logradouro, cidade, estado, CEP)"
    },
    "categories": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "Caldeiraria",
          "Refrigera\u00e7\u00e3o",
          "Motores",
          "El\u00e9trica",
          "Automa\u00e7\u00e3o",
          "Calibra\u00e7\u00e3o",
          "Radiadores"
        ]
      },
      "description": "Ramos de atividade (m\u00faltipla escolha): Caldeiraria, Refrigera\u00e7\u00e3o, Motores, El\u00e9trica, Automa\u00e7\u00e3o, Calibra\u00e7\u00e3o, Radiadores"
    },
    "categories_history": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "categories": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Ramos de atividade definidos na altera\u00e7\u00e3o"
          },
          "changed_by": {
            "type": "string",
            "description": "Email do administrador que alterou os ramos"
          },
          "changed_at": {
            "type": "string",
            "format": "date-time",
            "description": "Data/hora da altera\u00e7\u00e3o"
          }
        }
      },
      "description": "Hist\u00f3rico de altera\u00e7\u00f5es dos ramos de atividade (auditoria)"
    },
    "photo_uri": {
      "type": "string",
      "description": "Caminho da foto/logomarca no armazenamento privado (JPG, PNG ou WEBP), exibida via URL assinada"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "inactive"
      ],
      "default": "active"
    }
  },
  "required": [
    "company_name",
    "cnpj"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": null,
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
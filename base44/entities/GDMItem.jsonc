{
  "name": "GDMItem",
  "type": "object",
  "properties": {
    "gdm_id": {
      "type": "string",
      "description": "ID da GDM a que o item pertence"
    },
    "vessel_id": {
      "type": "string",
      "description": "ID da embarca\u00e7\u00e3o (denormalizado da GDM para escopo de acesso)"
    },
    "vessel_name": {
      "type": "string",
      "description": "Nome da embarca\u00e7\u00e3o (denormalizado)"
    },
    "item_number": {
      "type": "number",
      "default": 1,
      "description": "N\u00famero sequencial do item dentro da GDM"
    },
    "equipment_id": {
      "type": "string",
      "description": "ID do equipamento"
    },
    "equipment_code": {
      "type": "string",
      "description": "C\u00f3digo do equipamento"
    },
    "equipment_name": {
      "type": "string",
      "description": "Nome do equipamento"
    },
    "serial_number": {
      "type": "string",
      "description": "N\u00famero de s\u00e9rie"
    },
    "quantity": {
      "type": "number",
      "default": 1,
      "description": "Quantidade desembarcada"
    },
    "os_number": {
      "type": "string",
      "description": "N\u00famero da OS do item"
    },
    "destination": {
      "type": "string",
      "enum": [
        "repair",
        "certification",
        "stock_return",
        "discard"
      ],
      "default": "repair",
      "description": "Destino do item: reparo, calibra\u00e7\u00e3o, retorno ao estoque ou descarte"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "pending_coordinator",
        "approved",
        "rejected",
        "cancelled",
        "pending_almoxarifado",
        "received",
        "pending_services",
        "awaiting_supplier_definition",
        "awaiting_shipping_proof",
        "sent_to_supplier",
        "in_treatment",
        "awaiting_return",
        "awaiting_supplier_return",
        "return_confirmed",
        "pending_maintenance_authorization",
        "repair_approved",
        "discount_negotiation",
        "awaiting_discard_confirmation",
        "discard_approved",
        "pending_disembark_confirmation",
        "disembark_rescheduled",
        "completed"
      ],
      "default": "pending_coordinator",
      "description": "Situa\u00e7\u00e3o do item (fluxo pr\u00f3prio por destino, com confirma\u00e7\u00e3o de desembarque e ciclo completo de fornecedor)"
    },
    "supplier_id": {
      "type": "string",
      "description": "ID do fornecedor respons\u00e1vel pela tratativa atual do item"
    },
    "supplier_name": {
      "type": "string",
      "description": "Nome do fornecedor"
    },
    "supplier_selected_at": {
      "type": "string",
      "format": "date-time",
      "description": "Data/hora da defini\u00e7\u00e3o do fornecedor pelo setor de Servi\u00e7os"
    },
    "supplier_selected_by": {
      "type": "string",
      "description": "Email de quem definiu o fornecedor"
    },
    "expected_ship_date": {
      "type": "string",
      "format": "date",
      "description": "Previs\u00e3o de envio ao fornecedor informada por Servi\u00e7os"
    },
    "shipping_proof_url": {
      "type": "string",
      "description": "URL da NF assinada anexada pelo Almoxarifado no envio ao fornecedor"
    },
    "shipping_photo_url": {
      "type": "string",
      "description": "URL da foto do envio anexada pelo Almoxarifado (obrigat\u00f3ria junto com a NF)"
    },
    "shipping_proof_at": {
      "type": "string",
      "format": "date-time",
      "description": "Data/hora do anexo do comprovante de envio"
    },
    "shipping_proof_by": {
      "type": "string",
      "description": "Email de quem anexou o comprovante de envio"
    },
    "sent_to_supplier_at": {
      "type": "string",
      "format": "date-time",
      "description": "Data/hora do envio ao fornecedor (comprovante anexado)"
    },
    "sent_by": {
      "type": "string",
      "description": "Email do respons\u00e1vel pelo envio"
    },
    "quote_due_at": {
      "type": "string",
      "format": "date-time",
      "description": "Prazo limite de 3 dias corridos para recebimento da cota\u00e7\u00e3o (contador autom\u00e1tico)"
    },
    "quote_followup_notified_at": {
      "type": "string",
      "format": "date-time",
      "description": "Data/hora da \u00faltima notifica\u00e7\u00e3o de follow-up de cota\u00e7\u00e3o enviada a Servi\u00e7os neste ciclo"
    },
    "quote_value": {
      "type": "number",
      "description": "Valor da cota\u00e7\u00e3o atual do reparo"
    },
    "quote_document_url": {
      "type": "string",
      "description": "URL do documento da cota\u00e7\u00e3o atual"
    },
    "quote_deadline": {
      "type": "string",
      "format": "date",
      "description": "Prazo de execu\u00e7\u00e3o informado pelo fornecedor"
    },
    "quote_attached_at": {
      "type": "string",
      "format": "date-time",
      "description": "Data/hora do anexo da cota\u00e7\u00e3o"
    },
    "quote_attached_by": {
      "type": "string",
      "description": "Email de quem anexou a cota\u00e7\u00e3o"
    },
    "quotes_history": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "supplier_id": {
            "type": "string"
          },
          "supplier_name": {
            "type": "string"
          },
          "quote_value": {
            "type": "number"
          },
          "quote_document_url": {
            "type": "string"
          },
          "quote_deadline": {
            "type": "string",
            "format": "date"
          },
          "registered_by": {
            "type": "string",
            "description": "Usu\u00e1rio que registrou a cota\u00e7\u00e3o"
          },
          "registered_at": {
            "type": "string"
          },
          "outcome": {
            "type": "string",
            "description": "Desfecho da cota\u00e7\u00e3o: submetida, aprovada, em negocia\u00e7\u00e3o, reprovada ou renegociada"
          },
          "reason": {
            "type": "string",
            "description": "Motivo do desfecho (aprova\u00e7\u00e3o, reprova\u00e7\u00e3o ou negocia\u00e7\u00e3o)"
          },
          "decided_by": {
            "type": "string"
          },
          "decided_at": {
            "type": "string"
          }
        }
      },
      "description": "Todas as cota\u00e7\u00f5es e propostas recebidas, nunca exclu\u00eddas (auditoria completa)"
    },
    "maintenance_decision": {
      "type": "string",
      "enum": [
        "approved",
        "discount_requested",
        "rejected"
      ],
      "description": "Decis\u00e3o da Ger\u00eancia de Manuten\u00e7\u00e3o sobre a cota\u00e7\u00e3o atual"
    },
    "maintenance_reject_outcome": {
      "type": "string",
      "enum": [
        "other_supplier",
        "discard"
      ],
      "description": "Desfecho escolhido na reprova\u00e7\u00e3o: enviar para outro fornecedor ou descartar o equipamento"
    },
    "maintenance_decided_by": {
      "type": "string"
    },
    "maintenance_decided_at": {
      "type": "string",
      "format": "date-time"
    },
    "discount_percentage": {
      "type": "number",
      "description": "Percentual de desconto solicitado pela Manuten\u00e7\u00e3o"
    },
    "return_nf_url": {
      "type": "string",
      "description": "URL da NF de retorno do fornecedor anterior"
    },
    "return_proof_url": {
      "type": "string",
      "description": "URL do comprovante de devolu\u00e7\u00e3o do fornecedor anterior"
    },
    "return_registered_at": {
      "type": "string",
      "format": "date-time",
      "description": "Data/hora do registro da devolu\u00e7\u00e3o por Servi\u00e7os"
    },
    "return_registered_by": {
      "type": "string",
      "description": "Email de quem registrou a devolu\u00e7\u00e3o"
    },
    "return_confirmed_at": {
      "type": "string",
      "format": "date-time",
      "description": "Data/hora da confirma\u00e7\u00e3o de recebimento do retorno pelo Almoxarifado"
    },
    "return_confirmed_by": {
      "type": "string",
      "description": "Email de quem confirmou o recebimento do retorno"
    },
    "previous_suppliers": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "supplier_id": {
            "type": "string"
          },
          "supplier_name": {
            "type": "string"
          },
          "sent_at": {
            "type": "string",
            "description": "Data do envio ao fornecedor no ciclo encerrado"
          },
          "returned_at": {
            "type": "string",
            "description": "Data do retorno confirmado pelo Almoxarifado"
          },
          "reason": {
            "type": "string",
            "description": "Motivo do encerramento do ciclo (reprova\u00e7\u00e3o da cota\u00e7\u00e3o, troca de fornecedor etc.)"
          }
        }
      },
      "description": "Hist\u00f3rico de todos os fornecedores que participaram do item (ciclos encerrados, nunca removidos)"
    },
    "notes": {
      "type": "string",
      "description": "Observa\u00e7\u00f5es do item"
    },
    "stock_received_at": {
      "type": "string",
      "format": "date-time",
      "description": "Data/hora do recebimento pelo almoxarifado"
    },
    "stock_received_by": {
      "type": "string",
      "description": "ID de quem confirmou o recebimento"
    },
    "not_received_at": {
      "type": "string",
      "format": "date-time",
      "description": "Data/hora do registro de n\u00e3o recebimento pelo almoxarifado"
    },
    "not_received_by": {
      "type": "string",
      "description": "Email de quem registrou o n\u00e3o recebimento"
    },
    "disembark_confirmed_at": {
      "type": "string",
      "format": "date-time",
      "description": "Data/hora da confirma\u00e7\u00e3o de desembarque pela embarca\u00e7\u00e3o"
    },
    "disembark_confirmed_by": {
      "type": "string",
      "description": "Email de quem confirmou o desembarque"
    },
    "expected_disembark_date": {
      "type": "string",
      "format": "date",
      "description": "Nova data prevista de desembarque informada pela embarca\u00e7\u00e3o"
    },
    "reschedule_justification": {
      "type": "string",
      "description": "Justificativa da reprograma\u00e7\u00e3o do desembarque"
    },
    "stock_return_confirmed": {
      "type": "boolean",
      "default": false,
      "description": "Devolu\u00e7\u00e3o ao estoque confirmada"
    },
    "stock_return_number": {
      "type": "string",
      "description": "N\u00famero da devolu\u00e7\u00e3o ao estoque (opcional)"
    },
    "stock_return_at": {
      "type": "string",
      "format": "date-time",
      "description": "Data/hora da confirma\u00e7\u00e3o da devolu\u00e7\u00e3o"
    },
    "stock_return_by": {
      "type": "string",
      "description": "ID de quem confirmou a devolu\u00e7\u00e3o"
    },
    "discard_authorized": {
      "type": "boolean",
      "default": false,
      "description": "Descarte autorizado pelo gestor de manuten\u00e7\u00e3o"
    },
    "discard_authorized_by": {
      "type": "string",
      "description": "ID de quem autorizou o descarte"
    },
    "discard_authorized_at": {
      "type": "string",
      "format": "date-time",
      "description": "Data/hora da autoriza\u00e7\u00e3o do descarte"
    },
    "discard_confirmed": {
      "type": "boolean",
      "default": false,
      "description": "Descarte f\u00edsico confirmado pelo almoxarifado"
    },
    "discard_confirmed_by": {
      "type": "string",
      "description": "ID de quem confirmou o descarte"
    },
    "discard_confirmed_at": {
      "type": "string",
      "format": "date-time",
      "description": "Data/hora da confirma\u00e7\u00e3o do descarte"
    },
    "discard_notes": {
      "type": "string",
      "description": "Observa\u00e7\u00f5es da confirma\u00e7\u00e3o do descarte"
    },
    "completed_at": {
      "type": "string",
      "format": "date-time",
      "description": "Data/hora de finaliza\u00e7\u00e3o do item"
    },
    "completed_by": {
      "type": "string",
      "description": "Email de quem finalizou o item"
    }
  },
  "required": [
    "gdm_id",
    "equipment_name"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "coordinator"
          }
        },
        {
          "user_condition": {
            "role": "services"
          }
        },
        {
          "user_condition": {
            "role": "maintenance"
          }
        },
        {
          "user_condition": {
            "role": "almoxarifado"
          }
        },
        {
          "user_condition": {
            "role": "vessel_user"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.vessel_id": "{{user.data.vessel_id}}"
        },
        {
          "data.supplier_id": "{{user.data.supplier_id}}"
        },
        {
          "data.vessel_id": {
            "$in": "{{user.data.assigned_vessels}}"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "coordinator"
          }
        },
        {
          "user_condition": {
            "role": "services"
          }
        },
        {
          "user_condition": {
            "role": "maintenance"
          }
        },
        {
          "user_condition": {
            "role": "almoxarifado"
          }
        },
        {
          "user_condition": {
            "role": "planejamento"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.vessel_id": "{{user.data.vessel_id}}"
        },
        {
          "data.supplier_id": "{{user.data.supplier_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "coordinator"
          }
        },
        {
          "user_condition": {
            "role": "services"
          }
        },
        {
          "user_condition": {
            "role": "maintenance"
          }
        },
        {
          "user_condition": {
            "role": "almoxarifado"
          }
        },
        {
          "user_condition": {
            "role": "planejamento"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "coordinator"
          }
        },
        {
          "user_condition": {
            "role": "services"
          }
        }
      ]
    }
  }
}
{
  "name": "GDMItem",
  "type": "object",
  "properties": {
    "gdm_id": {
      "type": "string",
      "description": "ID da GDM a que o item pertence"
    },
    "vessel_id": {
      "type": "string",
      "description": "ID da embarca\u00e7\u00e3o (denormalizado da GDM para escopo de acesso)"
    },
    "vessel_name": {
      "type": "string",
      "description": "Nome da embarca\u00e7\u00e3o (denormalizado)"
    },
    "item_number": {
      "type": "number",
      "default": 1,
      "description": "N\u00famero sequencial do item dentro da GDM"
    },
    "equipment_id": {
      "type": "string",
      "description": "ID do equipamento"
    },
    "equipment_code": {
      "type": "string",
      "description": "C\u00f3digo do equipamento"
    },
    "equipment_name": {
      "type": "string",
      "description": "Nome do equipamento"
    },
    "serial_number": {
      "type": "string",
      "description": "N\u00famero de s\u00e9rie"
    },
    "quantity": {
      "type": "number",
      "default": 1,
      "description": "Quantidade desembarcada"
    },
    "os_number": {
      "type": "string",
      "description": "N\u00famero da OS do item"
    },
    "destination": {
      "type": "string",
      "enum": [
        "repair",
        "certification",
        "stock_return",
        "discard"
      ],
      "default": "repair",
      "description": "Destino do item: reparo, calibra\u00e7\u00e3o, retorno ao estoque ou descarte"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "pending_coordinator",
        "approved",
        "rejected",
        "cancelled",
        "pending_almoxarifado",
        "received",
        "pending_services",
        "sent_to_supplier",
        "in_treatment",
        "awaiting_return",
        "pending_maintenance_authorization",
        "awaiting_discard_confirmation",
        "pending_disembark_confirmation",
        "disembark_rescheduled",
        "completed"
      ],
      "default": "pending_coordinator",
      "description": "Situa\u00e7\u00e3o do item (fluxo pr\u00f3prio por destino, com confirma\u00e7\u00e3o de desembarque)"
    },
    "supplier_id": {
      "type": "string",
      "description": "ID do fornecedor respons\u00e1vel pela tratativa do item"
    },
    "supplier_name": {
      "type": "string",
      "description": "Nome do fornecedor"
    },
    "notes": {
      "type": "string",
      "description": "Observa\u00e7\u00f5es do item"
    },
    "stock_received_at": {
      "type": "string",
      "format": "date-time",
      "description": "Data/hora do recebimento pelo almoxarifado"
    },
    "stock_received_by": {
      "type": "string",
      "description": "ID de quem confirmou o recebimento"
    },
    "not_received_at": {
      "type": "string",
      "format": "date-time",
      "description": "Data/hora do registro de n\u00e3o recebimento pelo almoxarifado"
    },
    "not_received_by": {
      "type": "string",
      "description": "Email de quem registrou o n\u00e3o recebimento"
    },
    "disembark_confirmed_at": {
      "type": "string",
      "format": "date-time",
      "description": "Data/hora da confirma\u00e7\u00e3o de desembarque pela embarca\u00e7\u00e3o"
    },
    "disembark_confirmed_by": {
      "type": "string",
      "description": "Email de quem confirmou o desembarque"
    },
    "expected_disembark_date": {
      "type": "string",
      "format": "date",
      "description": "Nova data prevista de desembarque informada pela embarca\u00e7\u00e3o"
    },
    "reschedule_justification": {
      "type": "string",
      "description": "Justificativa da reprograma\u00e7\u00e3o do desembarque"
    },
    "stock_return_confirmed": {
      "type": "boolean",
      "default": false,
      "description": "Devolu\u00e7\u00e3o ao estoque confirmada"
    },
    "stock_return_number": {
      "type": "string",
      "description": "N\u00famero da devolu\u00e7\u00e3o ao estoque (opcional)"
    },
    "stock_return_at": {
      "type": "string",
      "format": "date-time",
      "description": "Data/hora da confirma\u00e7\u00e3o da devolu\u00e7\u00e3o"
    },
    "stock_return_by": {
      "type": "string",
      "description": "ID de quem confirmou a devolu\u00e7\u00e3o"
    },
    "discard_authorized": {
      "type": "boolean",
      "default": false,
      "description": "Descarte autorizado pelo gestor de manuten\u00e7\u00e3o"
    },
    "discard_authorized_by": {
      "type": "string",
      "description": "ID de quem autorizou o descarte"
    },
    "discard_authorized_at": {
      "type": "string",
      "format": "date-time",
      "description": "Data/hora da autoriza\u00e7\u00e3o do descarte"
    },
    "discard_confirmed": {
      "type": "boolean",
      "default": false,
      "description": "Descarte f\u00edsico confirmado pelo almoxarifado"
    },
    "discard_confirmed_by": {
      "type": "string",
      "description": "ID de quem confirmou o descarte"
    },
    "discard_confirmed_at": {
      "type": "string",
      "format": "date-time",
      "description": "Data/hora da confirma\u00e7\u00e3o do descarte"
    },
    "discard_notes": {
      "type": "string",
      "description": "Observa\u00e7\u00f5es da confirma\u00e7\u00e3o do descarte"
    },
    "completed_at": {
      "type": "string",
      "format": "date-time",
      "description": "Data/hora de finaliza\u00e7\u00e3o do item"
    },
    "completed_by": {
      "type": "string",
      "description": "Email de quem finalizou o item"
    }
  },
  "required": [
    "gdm_id",
    "equipment_name"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "coordinator"
          }
        },
        {
          "user_condition": {
            "role": "services"
          }
        },
        {
          "user_condition": {
            "role": "maintenance"
          }
        },
        {
          "user_condition": {
            "role": "almoxarifado"
          }
        },
        {
          "user_condition": {
            "role": "vessel_user"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.vessel_id": "{{user.data.vessel_id}}"
        },
        {
          "data.supplier_id": "{{user.data.supplier_id}}"
        },
        {
          "data.vessel_id": {
            "$in": "{{user.data.assigned_vessels}}"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "coordinator"
          }
        },
        {
          "user_condition": {
            "role": "services"
          }
        },
        {
          "user_condition": {
            "role": "maintenance"
          }
        },
        {
          "user_condition": {
            "role": "almoxarifado"
          }
        },
        {
          "user_condition": {
            "role": "planejamento"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.vessel_id": "{{user.data.vessel_id}}"
        },
        {
          "data.supplier_id": "{{user.data.supplier_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "coordinator"
          }
        },
        {
          "user_condition": {
            "role": "services"
          }
        },
        {
          "user_condition": {
            "role": "maintenance"
          }
        },
        {
          "user_condition": {
            "role": "almoxarifado"
          }
        },
        {
          "user_condition": {
            "role": "planejamento"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "coordinator"
          }
        },
        {
          "user_condition": {
            "role": "services"
          }
        }
      ]
    }
  }
}
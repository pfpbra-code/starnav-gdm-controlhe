{
  "name": "Vessel",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Nome da embarca\u00e7\u00e3o"
    },
    "code": {
      "type": "string",
      "description": "C\u00f3digo identificador \u00fanico"
    },
    "type": {
      "type": "string",
      "enum": [
        "PSV",
        "AHTS",
        "RSV",
        "OSRV",
        "FSV",
        "Outro"
      ],
      "description": "Tipo de embarca\u00e7\u00e3o"
    },
    "coordinator_id": {
      "type": "string",
      "description": "ID do coordenador respons\u00e1vel"
    },
    "responsible_user_id": {
      "type": "string",
      "description": "ID do usu\u00e1rio respons\u00e1vel pela embarca\u00e7\u00e3o (perfil Embarca\u00e7\u00e3o)"
    },
    "responsible_email": {
      "type": "string",
      "description": "E-mail do usu\u00e1rio respons\u00e1vel pela embarca\u00e7\u00e3o"
    },
    "sector_responsibles": {
      "type": "object",
      "description": "Respons\u00e1veis por setor vinculados \u00e0 embarca\u00e7\u00e3o: chave = setor (services, almoxarifado, maintenance, planejamento, operations), valor = lista de e-mails dos usu\u00e1rios respons\u00e1veis",
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "properties": {
        "services": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "E-mails dos respons\u00e1veis de Servi\u00e7os"
        },
        "almoxarifado": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "E-mails dos respons\u00e1veis do Almoxarifado"
        },
        "maintenance": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "E-mails dos respons\u00e1veis de Manuten\u00e7\u00e3o"
        },
        "planejamento": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "E-mails dos respons\u00e1veis de Planejamento"
        },
        "operations": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "E-mails dos respons\u00e1veis de Opera\u00e7\u00f5es"
        }
      }
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "inactive",
        "maintenance"
      ],
      "default": "active"
    },
    "photo_url": {
      "type": "string",
      "description": "URL da foto da embarca\u00e7\u00e3o (armazenada no storage)"
    },
    "login_password": {
      "type": "string",
      "description": "Senha de acesso da embarca\u00e7\u00e3o"
    }
  },
  "required": [
    "name",
    "code"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": null,
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
{
  "name": "PasswordPolicy",
  "type": "object",
  "properties": {
    "min_length": {
      "type": "number",
      "default": 8,
      "description": "Comprimento m\u00ednimo da senha"
    },
    "require_uppercase": {
      "type": "boolean",
      "default": true
    },
    "require_lowercase": {
      "type": "boolean",
      "default": true
    },
    "require_numbers": {
      "type": "boolean",
      "default": true
    },
    "require_special_chars": {
      "type": "boolean",
      "default": false
    },
    "expiration_days": {
      "type": "number",
      "default": 90,
      "description": "Dias at\u00e9 expira\u00e7\u00e3o da senha (0 = nunca expira)"
    },
    "max_failed_attempts": {
      "type": "number",
      "default": 5,
      "description": "Tentativas antes de bloquear conta"
    },
    "lockout_duration_minutes": {
      "type": "number",
      "default": 30,
      "description": "Minutos de bloqueio ap\u00f3s falhas"
    },
    "password_history": {
      "type": "number",
      "default": 3,
      "description": "N\u00famero de senhas antigas que n\u00e3o podem ser reutilizadas"
    },
    "is_active": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
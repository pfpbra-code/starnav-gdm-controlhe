{
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "alertas_controle_ot",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "notify_ot_alerts": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "notifyWorkOrderAlerts"
          },
          "then": "end",
          "x-base44": {
            "title": "Verificar alertas de OT",
            "description": "Alerta Servi\u00e7os e Almoxarifado sobre OTs pendentes"
          }
        }
      }
    ]
  },
  "name": "Alertas de Controle de OT",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "30 7 * * *",
      "one_time_date": null,
      "timezone": "America/Sao_Paulo",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "description": "Notifica Servi\u00e7os e Almoxarifado sobre equipamentos recebidos com OT aberta, OTs abertas h\u00e1 mais de 15/30/60 dias e equipamentos aguardando a\u00e7\u00e3o do Almoxarifado"
}
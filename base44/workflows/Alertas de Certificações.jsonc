{
  "name": "Alertas de Certifica\u00e7\u00f5es",
  "description": "Notifica Opera\u00e7\u00f5es e Administradores sobre vencimentos de certifica\u00e7\u00f5es (90/60/30/15 dias, no dia do vencimento e vencidas)",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "0 7 * * *",
      "one_time_date": null,
      "timezone": "America/Sao_Paulo",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "alertas_certificacoes",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "notify_certifications": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "notifyCertificationAlerts"
          },
          "then": "end",
          "x-base44": {
            "title": "Verificar vencimentos de certifica\u00e7\u00e3o",
            "description": "Alerta Opera\u00e7\u00f5es e Admins"
          }
        }
      }
    ]
  }
}